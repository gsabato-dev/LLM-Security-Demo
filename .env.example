# LLM API Keys (choose at least one)
# Get your API keys from:
# - Google Gemini: https://makersuite.google.com/app/apikey
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic Claude: https://console.anthropic.com/

GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Cloud Vertex AI (Alternative to API keys above)
# Requires GCP project with Vertex AI API enabled
# For setup: see SETUP_SECRET_MANAGER.md
USE_SECRET_MANAGER=false
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# App Configuration
DEFAULT_PROVIDER=gemini
DATABASE_PATH=recipes.db
ENABLE_LOGGING=true
LOG_FILE=injection_attempts.log
PROMPT_VERSION=strict
